{
  "name": "api-redacoes",
  "version": "2.0.0",
  "description": "API de notas de redação com Express 5, Sequelize (MySQL), JWT, perfis de acesso, boletim e estatísticas",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "nodejs",
    "express",
    "sequelize",
    "mysql",
    "jwt",
    "rbac",
    "educacao"
  ],
  "author": "Roberto Filho",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/helpers/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "overrides": {
    "uuid": "^11.1.1",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "sqlite3": "^6.0.1",
    "supertest": "^7.3.2"
  }
}
