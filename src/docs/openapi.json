{
  "openapi": "3.0.3",
  "info": {
    "title": "API de Notas de Redação",
    "version": "2.0.0",
    "description": "Gestão de notas de redação do 3º ano. A professora lança e gerencia as notas, e cada aluno consulta apenas o próprio boletim."
  },
  "servers": [
    {
      "url": "http://localhost:3001"
    }
  ],
  "tags": [
    {
      "name": "Autenticação"
    },
    {
      "name": "Usuários",
      "description": "Somente professora"
    },
    {
      "name": "Notas"
    },
    {
      "name": "Sistema"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Sistema"],
        "summary": "Status da API e do banco",
        "responses": {
          "200": {
            "description": "OK"
          },
          "503": {
            "description": "Banco indisponível"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Login (professora por e-mail, aluno por matrícula)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "429": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Autenticação"],
        "summary": "Usuário autenticado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "post": {
        "tags": ["Usuários"],
        "summary": "Cadastra aluno ou professora",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/NovoAluno"
                  },
                  {
                    "$ref": "#/components/schemas/NovaProfessora"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "409": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/alunos": {
      "get": {
        "tags": ["Usuários"],
        "summary": "Lista alunos",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "serie",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "busca",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/{id}": {
      "patch": {
        "tags": ["Usuários"],
        "summary": "Atualiza nome, série, senha ou ativa/desativa",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {
                    "type": "string"
                  },
                  "serie": {
                    "type": "string"
                  },
                  "ativo": {
                    "type": "boolean"
                  },
                  "senha": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/api/notas": {
      "get": {
        "tags": ["Notas"],
        "summary": "Lista notas (aluno vê só as próprias)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "matricula",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "serie",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bimestre",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          {
            "name": "disciplina",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Notas"],
        "summary": "Lança nota (professora). A média é calculada pelo servidor",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotaInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Criada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Nota"
                }
              }
            }
          },
          "400": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/api/notas/estatisticas": {
      "get": {
        "tags": ["Notas"],
        "summary": "Estatísticas da turma (professora)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "serie",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bimestre",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Média da turma, maior, menor, acima da média e distribuição por faixa"
          },
          "403": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/api/notas/aluno/{matricula}": {
      "get": {
        "tags": ["Notas"],
        "summary": "Boletim do aluno (professora ou o próprio aluno)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "matricula",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "2025001"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Boletim"
                }
              }
            }
          },
          "403": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/api/notas/{id}": {
      "put": {
        "tags": ["Notas"],
        "summary": "Atualiza nota e recalcula a média (professora)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotaInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Nota"
                }
              }
            }
          },
          "400": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Notas"],
        "summary": "Remove nota (professora)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removida"
          },
          "403": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginInput": {
        "type": "object",
        "required": ["senha"],
        "properties": {
          "email": {
            "type": "string",
            "example": "beth@escola.com"
          },
          "matricula": {
            "type": "string",
            "example": "2025001"
          },
          "senha": {
            "type": "string",
            "example": "Senha123"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresIn": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "matricula": {
            "type": "string"
          },
          "serie": {
            "type": "string"
          },
          "papel": {
            "type": "string",
            "enum": ["aluno", "professora"]
          },
          "ativo": {
            "type": "boolean"
          }
        }
      },
      "NovoAluno": {
        "type": "object",
        "required": ["papel", "nome", "matricula", "serie", "senha"],
        "properties": {
          "papel": {
            "type": "string",
            "enum": ["aluno"]
          },
          "nome": {
            "type": "string"
          },
          "matricula": {
            "type": "string"
          },
          "serie": {
            "type": "string",
            "example": "3A"
          },
          "senha": {
            "type": "string"
          }
        }
      },
      "NovaProfessora": {
        "type": "object",
        "required": ["papel", "nome", "email", "senha"],
        "properties": {
          "papel": {
            "type": "string",
            "enum": ["professora"]
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "senha": {
            "type": "string"
          }
        }
      },
      "NotaInput": {
        "type": "object",
        "required": ["matricula", "bimestre", "nota1", "nota2"],
        "properties": {
          "matricula": {
            "type": "string",
            "example": "2025001"
          },
          "disciplina": {
            "type": "string",
            "default": "Redação"
          },
          "tema": {
            "type": "string",
            "example": "Desafios da educação digital no Brasil"
          },
          "bimestre": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "nota1": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "example": 8
          },
          "nota2": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "example": 9
          },
          "peso1": {
            "type": "integer",
            "default": 1
          },
          "peso2": {
            "type": "integer",
            "default": 2
          },
          "comentario": {
            "type": "string"
          }
        }
      },
      "Nota": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "alunoId": {
            "type": "integer"
          },
          "disciplina": {
            "type": "string"
          },
          "tema": {
            "type": "string"
          },
          "bimestre": {
            "type": "integer"
          },
          "nota1": {
            "type": "number"
          },
          "nota2": {
            "type": "number"
          },
          "peso1": {
            "type": "integer"
          },
          "peso2": {
            "type": "integer"
          },
          "media": {
            "type": "number",
            "example": 8.67
          },
          "comentario": {
            "type": "string"
          },
          "aluno": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "Boletim": {
        "type": "object",
        "properties": {
          "aluno": {
            "$ref": "#/components/schemas/User"
          },
          "mediaGeral": {
            "type": "number"
          },
          "situacao": {
            "type": "string",
            "enum": ["aprovado", "abaixo_da_media", "sem_notas"]
          },
          "mediaAprovacao": {
            "type": "number"
          },
          "bimestres": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bimestre": {
                  "type": "integer"
                },
                "quantidade": {
                  "type": "integer"
                },
                "media": {
                  "type": "number",
                  "nullable": true
                },
                "notas": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Nota"
                  }
                }
              }
            }
          }
        }
      },
      "Erro": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "campo": {
                  "type": "string"
                },
                "mensagem": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
