NODE_ENV=development
PORT=3001
# Origens do front-end, separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# mysql (padrão) ou sqlite (desenvolvimento rápido, sem instalar banco)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=redacoes
# Usado apenas com DB_DIALECT=sqlite
DB_STORAGE=./dev.sqlite

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
MEDIA_APROVACAO=6
